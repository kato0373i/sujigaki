{
  "name": "sujigaki",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "lint": "biome check",
    "format": "biome check --write",
    "local": "node apps/cli/src/main.ts",
    "build": "npm run build -w @sujigaki/web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0"
  },
  "overrides": {
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "vite": "8.3.5",
    "axe-core": "4.14.0"
  }
}
